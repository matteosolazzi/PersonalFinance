generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id       String     @id @default(cuid())
  name     String     @unique
  type     ClientType @default(PIVA)
  isActive Boolean    @default(true)
  createdAt DateTime  @default(now())
  invoices Invoice[]
}

enum ClientType {
  PIVA
  OCCASIONAL
}

model TaxRate {
  id        String   @id @default(cuid())
  year      Int      @unique
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String   @id @default(cuid())
  year          Int
  invoiceNumber String
  date          DateTime
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  amount        Float
  amountAccrued Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AssetCategory {
  id           String      @id @default(cuid())
  name         String      @unique
  displayName  String
  displayOrder Int
  items        AssetItem[]
}

model AssetItem {
  id              String        @id @default(cuid())
  categoryId      String
  category        AssetCategory @relation(fields: [categoryId], references: [id])
  name            String
  broker          String?
  isActive        Boolean       @default(true)
  isPrivateEquity Boolean       @default(false)
  isShares        Boolean       @default(false)
  geoAllocUs      Float?
  geoAllocDevExUs Float?
  geoAllocEm      Float?
  displayOrder    Int           @default(0)
  createdAt       DateTime      @default(now())
  values          NetWorthValue[]
}

model NetWorthPeriod {
  id        String          @id @default(cuid())
  year      Int
  quarter   Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  values    NetWorthValue[]

  @@unique([year, quarter])
}

model NetWorthValue {
  id            String         @id @default(cuid())
  periodId      String
  period        NetWorthPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  assetItemId   String
  assetItem     AssetItem      @relation(fields: [assetItemId], references: [id])
  value         Float          @default(0)
  shares        Float?
  pricePerShare Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([periodId, assetItemId])
}
